# Copy to .env and fill in. Everything except DATABASE_URL has a dev default.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://fm:fm@localhost:5432/fortune_muse
JWT_SECRET=dev-only-change-me-please
APP_URL=http://localhost:8081
API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Claude API — leave empty to use the offline mock generator
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low

# Stripe — leave empty to use the dev payment flow (blocked in production)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

MAIL_TRANSPORT=console
POSTMARK_TOKEN=
MAIL_FROM=Fortune Muse <hello@fortunemuse.app>

# Sign in with Google / Microsoft / Apple. Leave empty to use a local test page in development
# (providers without keys are hidden in production). Register this redirect URI with each provider:
#   {API_URL}/auth/oauth/google|microsoft|apple/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Super accounts (admin console + free readings once the email is verified), comma separated
SUPER_EMAILS=

# Extra console-only admins, granted once the email is verified. Leave empty to use SUPER_EMAILS only.
ADMIN_EMAILS=
LAUNCH_COUNTRIES=US
